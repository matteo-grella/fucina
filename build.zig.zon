.{
    .name = .fucina,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0xf1039dfe7c588a04,
    .dependencies = .{},
    // What `zig fetch` consumers receive: the two library modules and what
    // their build needs (the Metal shim, CUDA PTX, and the vendored
    // llguidance staticlib source live under src/ and vendor/). Examples,
    // docs, goldens, and tools are in-tree development surface — excluded,
    // which also keeps a local path-based fetch from packaging untracked
    // model files.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "vendor",
        "LICENSE",
        "README.md",
        "docs/THIRD-PARTY-NOTICES.md",
    },
}
